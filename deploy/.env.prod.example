# Copy to deploy/.env.prod and fill in. deploy.sh copies this to the host as
# .env. NEVER commit deploy/.env.prod.

# From `terraform -chdir=deploy/terraform output`:
DATABASE_URL=postgresql+psycopg2://aicsp:CHANGE_ME@ai-customer-support-db.xxxx.ap-south-1.rds.amazonaws.com:5432/ai_support
SITE_ADDRESS=1-2-3-4.nip.io
SITE_URL=https://1-2-3-4.nip.io

# Your details:
ACME_EMAIL=you@example.com
GROQ_API_KEY=gsk_...
SECRET_KEY=generate-a-long-random-string

# Optional
GROQ_MODEL=openai/gpt-oss-120b

# Public demo: lets visitors start a guest session with sample documents.
# GLOBAL_DAILY_CHAT_LIMIT caps total questions per UTC day across all users so
# a flood can't burn through your Groq quota (0 = no cap).
DEMO_ENABLED=true
DEMO_MAX_MESSAGES=30
DEMO_USER_TTL_HOURS=24
GLOBAL_DAILY_CHAT_LIMIT=300
