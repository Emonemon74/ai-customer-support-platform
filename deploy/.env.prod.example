# Copy to deploy/.env.prod and fill in. deploy.sh copies this to the host as
# .env. NEVER commit deploy/.env.prod.

# From `terraform -chdir=deploy/terraform output`:
DATABASE_URL=postgresql+psycopg2://aicsp:CHANGE_ME@ai-customer-support-db.xxxx.ap-south-1.rds.amazonaws.com:5432/ai_support
SITE_ADDRESS=1-2-3-4.nip.io
SITE_URL=https://1-2-3-4.nip.io

# Your details:
ACME_EMAIL=you@example.com
GROQ_API_KEY=gsk_...
SECRET_KEY=generate-a-long-random-string

# Optional
GROQ_MODEL=openai/gpt-oss-120b
